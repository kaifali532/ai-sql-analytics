generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  datasets       Dataset[]
  queryHistories QueryHistory[]
  chatHistories  ChatHistory[]
  settings       Settings?
  activityLogs   ActivityLog[]
}

model Dataset {
  id           String   @id @default(uuid())
  userId       String
  originalName String
  tableName    String   @unique // The name of the table created in the user_data schema
  status       String   @default("PROCESSING") // PENDING, PROCESSING, READY, ERROR
  rowCount     Int      @default(0)
  sizeBytes    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  columns        DatasetColumn[]
  queryHistories QueryHistory[]
  chatHistories  ChatHistory[]
  insights       Insight[]
  uploadHistory  UploadHistory?
}

model DatasetColumn {
  id         String  @id @default(uuid())
  datasetId  String
  name       String
  type       String  // String, Integer, Float, Boolean, Date, etc.
  isNullable Boolean @default(true)
  isUnique   Boolean @default(false)
  isPrimaryKey Boolean @default(false)
  
  // Stats
  min        String?
  max        String?
  average    Float?
  median     Float?
  nullCount  Int     @default(0)
  uniqueCount Int    @default(0)

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
}

model QueryHistory {
  id            String   @id @default(uuid())
  userId        String
  datasetId     String
  prompt        String?
  sqlQuery      String
  executionTime Int      // in ms
  rowsReturned  Int      @default(0)
  isFavorite    Boolean  @default(false)
  createdAt     DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
}

model ChatHistory {
  id        String   @id @default(uuid())
  userId    String
  datasetId String
  role      String   // USER, AI
  content   String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
}

model Insight {
  id           String   @id @default(uuid())
  datasetId    String
  title        String
  description  String
  type         String   // TREND, ANOMALY, RECOMMENDATION, SUMMARY
  content      Json?    // Structured data if needed
  createdAt    DateTime @default(now())

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
}

model Settings {
  id        String   @id @default(uuid())
  userId    String   @unique
  theme     String   @default("system")
  language  String   @default("en")
  aiModel   String   @default("gemini-2.0-flash")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UploadHistory {
  id           String   @id @default(uuid())
  datasetId    String   @unique
  fileName     String
  fileSize     Int
  mimeType     String
  status       String   // SUCCESS, FAILED
  errorMessage String?
  createdAt    DateTime @default(now())

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
